 {
  "repo": "stargazer-map",
  "name": "v0.2.0",
  "tagName": "v0.2.0",
  "publishedAt": "2026-10-12T11:42:00Z",
  "url": "https://github.com/prism-oncology/stargazer-map/releases/tag/v0.2.0",
  "descriptionHTML": "<h2>stargazer-map 0.2.0</h2>\n<ul>\n<li><strong>Country map:</strong> countries are coloured by number of stargazers, andwe can viz countries, bubbles, or both.</li>\n<li><strong>Light/dark mode</strong> switch.</li>\n<li><strong>Cleaner bubbles:</strong> nearby places in the same country merge, duplicate spellings of a city are grouped, and country-only locations (\"USA\") no longer appear as places.</li>\n<li><strong>New settings:</strong> <code>MIN_STARS</code> to hide small repositories, <code>LOGO</code> to show logo.</li>\n<li><strong>Data now lives on a separate <code>data</code> branch,</strong> so the weekly update no longer commits to <code>main</code>.</li>\n</ul>\n<p><strong>Forks:</strong> the next run starts from empty data if your fork has no <code>data</code> branch.</p>",
  "isPrerelease": false
 },
